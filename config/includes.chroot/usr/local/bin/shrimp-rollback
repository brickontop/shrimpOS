#!/usr/bin/env python3
import subprocess, sys
from pathlib import Path
sys.path.insert(0,'/usr/local/lib/shrimp'); from audit import approve, propose
snap=Path('/var/lib/shrimp/snapshots')/(sys.argv[1] if len(sys.argv)>1 else '')
if not snap.is_file(): raise SystemExit('Usage: shrimp-rollback SIGNED-SNAPSHOT.squashfs')
if not snap.with_suffix(snap.suffix+'.asc').is_file(): raise SystemExit('Unsigned snapshot refused')
subprocess.run(['gpgv','--keyring','/etc/shrimp/store.gpg',str(snap)+'.asc',str(snap)],check=True)
r=propose('rollback',f'restore {snap.name}','current root','signed immutable snapshot')
approve(r,'RESTORE SNAPSHOT')
print('Approved. Boot recovery media and mount this verified snapshot; live-root replacement is intentionally not automated.')
